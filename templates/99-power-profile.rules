# Override Omarchy's default power-profile udev rule with a debounced version.
# The ROG Flow Z13 generates spurious power_supply events from AC0 and UCSI
# that cause repeated profile switches, fan curve rewrites, and notification spam.
# NOTE: No fixed --unit name — each udev event gets a unique auto-generated unit.
# A fixed name (e.g. --unit=omarchy-power-profile) causes collisions at boot
# when AC0 and multiple UCSI devices fire simultaneously, making every invocation
# after the first fail with "unit already exists".
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", RUN+="/usr/bin/systemd-run --no-block --collect --property=After=power-profiles-daemon.service __HOME__/.local/share/omarchy/bin/omarchy-powerprofiles-set-debounced"
SUBSYSTEM=="power_supply", ATTR{type}=="USB", RUN+="/usr/bin/systemd-run --no-block --collect --property=After=power-profiles-daemon.service __HOME__/.local/share/omarchy/bin/omarchy-powerprofiles-set-debounced"
