#!/bin/bash
# Debounced wrapper around omarchy-powerprofiles-set.
#
# The ROG Flow Z13 emits spurious power_supply events. AC0.online in particular
# flaps 0 <-> 1 every 1-3 seconds while the battery is actively charging
# (proven: the Mains-keyed wifi-powersave rule toggled 101 times in 14 minutes
# while capacity rose monotonically 53% -> 64%). Each event otherwise triggers
# a profile set -> asusd fan curve rewrite -> momentary fan stop, plus spam.
#
# Design history:
#
# v4 (2025-06-18): atomic mkdir sentinel instead of flock; double-read AC state
#   1.0s apart; 10s cooldown; idempotency.
#
# v5 (2026-09-15): replaced the double-read with 6 samples over 4.5s. Built on a
#   misdiagnosis -- the storm was believed load-triggered, but 35 minutes of
#   32-thread load at 90% charge produced zero events while charging produced
#   205 in 14 minutes. v5 was never observed under a storm.
#
# v6 (2026-09-15): switched to BAT0.status as the primary signal and re-keyed
#   the udev rule onto the battery. Correct direction, but the sampling guard
#   was wrong: "N samples must agree, else abort" rejects a *genuine*
#   transition, because the udev event fires before BAT0.status settles. A real
#   unplug was observed reading "Not charging" then "Discharging", concluding
#   "unstable", and doing nothing -- leaving the machine on performance while
#   on battery.
#
# v7 (2026-09-15): wait-for-stability instead of abort-on-disagreement.
#
#   BAT0.status reflects actual power flow and stays stable while AC0 flaps:
#     Discharging   -> on battery
#     Charging      -> on AC
#     Not charging  -> on AC (plugged in, at charge limit)
#     Full          -> on AC
#
#   The detector now polls until two consecutive readings agree, restarting the
#   window on a mismatch and retrying on unrecognised values, with a bounded
#   timeout. A mid-transition start therefore converges on the settled state
#   instead of bailing out. AC0 detection is retained only as a fallback for
#   machines without a readable system battery.
#
#   The 10s cooldown was removed. It could block a genuine second transition
#   (unplug then quickly replug) and leave stale state, while adding nothing:
#   the atomic sentinel collapses event bursts, and the idempotency check
#   already suppresses redundant powerprofilesctl calls. The charge-limit
#   toggle between "Charging" and "Not charging" maps to the same action, so it
#   is idempotent too.

STATEFILE="/run/user/${UID}/omarchy-powerprofiles.state"
PROCESSING="/run/user/${UID}/omarchy-powerprofiles.processing"

# Prefer the legacy checkout path, fall back to the packaged path (quattro).
ORIG_SCRIPT="__HOME__/.local/share/omarchy/bin/omarchy-powerprofiles-set"
[[ -x $ORIG_SCRIPT ]] || ORIG_SCRIPT="/usr/bin/omarchy-powerprofiles-set"

# Wait-for-stability: require STABLE_READS consecutive agreeing readings,
# polling every INTERVAL seconds, giving up after MAX_SAMPLES reads.
STABLE_READS=2
INTERVAL=1
MAX_SAMPLES=8

mkdir -p "$(dirname "$STATEFILE")"
mkdir -p "$(dirname "$PROCESSING")"

# ---------------------------------------------------------------------------
# Atomic deduplication: only one instance may proceed.
# mkdir is atomic on all POSIX filesystems -- if it succeeds, we are the sole
# worker; if it fails, another instance is already running and we exit
# immediately. Event bursts therefore collapse to a single evaluation.
#
# Stale sentinel cleanup: if a previous run crashed, the directory may be left
# behind. Remove it if it's older than 30 seconds (the stability window plus
# generous margin), then try again.
# ---------------------------------------------------------------------------
if ! mkdir "$PROCESSING" 2>/dev/null; then
    if [[ -d "$PROCESSING" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$PROCESSING" 2>/dev/null || echo 0) ))
        if (( age > 30 )); then
            rmdir "$PROCESSING" 2>/dev/null
            mkdir "$PROCESSING" 2>/dev/null || exit 0
        else
            exit 0
        fi
    else
        exit 0
    fi
fi

cleanup() { rmdir "$PROCESSING" 2>/dev/null || true; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
# 1. Determine the intended action
# ---------------------------------------------------------------------------

# Locate the system battery: type=Battery, excluding peripherals (scope=Device,
# e.g. the Elan touchpad's hid-...-battery-7, which reports capacity 0).
find_system_battery() {
    local ps scope
    for ps in /sys/class/power_supply/*; do
        [[ -r $ps/type && -r $ps/status ]] || continue
        [[ $(cat "$ps/type") == Battery ]] || continue
        scope=$(cat "$ps/scope" 2>/dev/null || echo "")
        [[ $scope == Device ]] && continue
        printf '%s\n' "$ps"
        return 0
    done
    return 1
}

# Map BAT0.status to an action. Returns non-zero on an inconclusive reading
# (e.g. "Unknown" during a transition), so the caller retries.
read_battery_action() {
    local status
    status=$(cat "$1/status" 2>/dev/null) || return 1
    case "$status" in
        Discharging)                  echo battery ;;
        Charging|"Not charging"|Full) echo ac ;;
        *)                            return 1 ;;
    esac
}

# Fallback for machines without a readable system battery: treat any Mains or
# USB supply reporting online=1 as AC.
read_ac_action() {
    local found=0 ps type
    for ps in /sys/class/power_supply/*; do
        [[ -r $ps/online && -r $ps/type ]] || continue
        type=$(cat "$ps/type")
        [[ $type == Mains || $type == USB ]] || continue
        if [[ $(cat "$ps/online") == 1 ]]; then
            found=1
            break
        fi
    done
    [[ $found == 1 ]] && echo ac || echo battery
}

detect_action() {
    local bat
    if bat=$(find_system_battery); then
        read_battery_action "$bat"
    else
        read_ac_action
    fi
}

# Poll until STABLE_READS consecutive readings agree. A mismatch restarts the
# window rather than aborting, so a mid-transition start converges on the
# settled value. Unrecognised readings reset the window and are retried.
action=""
prev=""
agree=0
for ((i = 0; i < MAX_SAMPLES; i++)); do
    if current=$(detect_action); then
        if [[ -n $prev && $current == "$prev" ]]; then
            agree=$((agree + 1))
            if (( agree >= STABLE_READS - 1 )); then
                action="$current"
                break
            fi
        else
            agree=0
        fi
        prev="$current"
    else
        prev=""
        agree=0
    fi
    sleep "$INTERVAL"
done

# Never settled within the window: leave it to the next event.
[[ -n $action ]] || exit 0

# ---------------------------------------------------------------------------
# 2. Idempotency: skip if AC state and resulting profile are unchanged
# ---------------------------------------------------------------------------
last_action=""
last_profile=""
if [[ -r "$STATEFILE" ]]; then
    read -r last_action last_profile < "$STATEFILE" 2>/dev/null || true
fi

mapfile -t profiles < <(powerprofilesctl list 2>/dev/null | awk '/^\s*[* ]\s*[a-zA-Z0-9\-]+:$/ { gsub(/^[*[:space:]]+|:$/,""); print }')

target_profile=""
case "$action" in
    ac)
        if [[ " ${profiles[*]} " == *" performance "* ]]; then
            target_profile="performance"
        else
            target_profile="balanced"
        fi
        ;;
    battery)
        target_profile="balanced"
        ;;
esac

if [[ "$action" == "$last_action" && "$target_profile" == "$last_profile" ]]; then
    # Nothing changed -- skip the powerprofilesctl call entirely to avoid
    # asusd re-evaluating EPP and rewriting fan curves on every event.
    exit 0
fi

# ---------------------------------------------------------------------------
# 3. Run the original script and persist state
# ---------------------------------------------------------------------------
if "$ORIG_SCRIPT" "$action"; then
    echo "$action $target_profile" > "$STATEFILE"
fi
