#!/bin/bash
# Debounced wrapper around omarchy-powerprofiles-set.
# The ROG Flow Z13 generates spurious power_supply change events from both
# AC0 (proprietary charger) and ucsi-source-psy-USBC000:001/002 (USB-C UCSI
# controller). Without debouncing, each event triggers a full profile set ->
# asusd fan curve rewrite -> momentary fan stop.
#
# v4 fix (2025-06-18):
# - Atomic mkdir sentinel (replaces flock): only one instance does work,
#   all others exit immediately. flock was serializing instances, causing
#   each queued event to re-evaluate independently and flip-flop.
# - Double-read AC state with 1.0s stability check (was 0.2s) — catches
#   longer transients during low-battery kernel enumeration.
# - 10-second cooldown after any actual change (was 3s) — suppresses
#   follow-up events that arrive 5-15s apart during UCSI settling.
# - Idempotency preserved (v2/v3).

STATEFILE="/run/user/${UID}/omarchy-powerprofiles.state"
COOLDOWN_FILE="/run/user/${UID}/omarchy-powerprofiles.lastcall"
PROCESSING="/run/user/${UID}/omarchy-powerprofiles.processing"
ORIG_SCRIPT="__HOME__/.local/share/omarchy/bin/omarchy-powerprofiles-set"

mkdir -p "$(dirname "$STATEFILE")"
mkdir -p "$(dirname "$COOLDOWN_FILE")"
mkdir -p "$(dirname "$PROCESSING")"

# ---------------------------------------------------------------------------
# Atomic deduplication: only one instance may proceed.
# mkdir is atomic on all POSIX filesystems — if it succeeds, we are the
# sole worker; if it fails, another instance is already running and we
# exit immediately.  This avoids the flock queuing problem where N queued
# instances would each re-evaluate state independently, causing a cascade
# of profile flips.
#
# Stale sentinel cleanup: if a previous run crashed, the directory may be
# left behind.  Remove it if it's older than 10 seconds, then try again.
# ---------------------------------------------------------------------------
if ! mkdir "$PROCESSING" 2>/dev/null; then
    # Directory exists — check if it's stale (older than 10s).
    if [[ -d "$PROCESSING" ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$PROCESSING" 2>/dev/null || echo 0) ))
        if (( age > 10 )); then
            rmdir "$PROCESSING" 2>/dev/null
            mkdir "$PROCESSING" 2>/dev/null || exit 0
        else
            exit 0
        fi
    else
        exit 0
    fi
fi

# Ensure cleanup always runs, even on error or early exit.
cleanup() { rmdir "$PROCESSING" 2>/dev/null || true; }
trap cleanup EXIT

# ---------------------------------------------------------------------------
# 0. Cooldown: skip if we changed the profile very recently
# ---------------------------------------------------------------------------
now=$(date +%s)
last_call=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
if (( now - last_call < 10 )); then
    # Another event fired within 10s of the last actual change — likely a
    # follow-up from the same physical transition.  Ignore it.
    exit 0
fi

# ---------------------------------------------------------------------------
# 1. AC state detection with stability check (double-read)
# ---------------------------------------------------------------------------
read_ac_state() {
    local found=0
    for ps in /sys/class/power_supply/*; do
        [[ -r "$ps/online" && -r "$ps/type" ]] || continue
        type=$(cat "$ps/type")
        [[ "$type" == "Mains" || "$type" == "USB" ]] || continue
        if [[ $(cat "$ps/online") == "1" ]]; then
            found=1
            break
        fi
    done
    echo "$found"
}

ac_read1=$(read_ac_state)
sleep 1.0
ac_read2=$(read_ac_state)

if [[ "$ac_read1" == "1" && "$ac_read2" == "1" ]]; then
    action="ac"
elif [[ "$ac_read1" == "0" && "$ac_read2" == "0" ]]; then
    action="battery"
else
    # Unstable reading (transient UCSI / suspend-wake glitch).
    # Don't act — a stable event will arrive shortly.
    exit 0
fi

# ---------------------------------------------------------------------------
# 2. Idempotency: skip if AC state and resulting profile are unchanged
# ---------------------------------------------------------------------------
last_action=""
last_profile=""
if [[ -r "$STATEFILE" ]]; then
    read -r last_action last_profile < "$STATEFILE" 2>/dev/null || true
fi

mapfile -t profiles < <(powerprofilesctl list 2>/dev/null | awk '/^\s*[* ]\s*[a-zA-Z0-9\-]+:$/ { gsub(/^[*[:space:]]+|:$/,""); print }')

target_profile=""
case "$action" in
    ac)
        if [[ " ${profiles[*]} " == *" performance "* ]]; then
            target_profile="performance"
        else
            target_profile="balanced"
        fi
        ;;
    battery)
        target_profile="balanced"
        ;;
esac

if [[ "$action" == "$last_action" && "$target_profile" == "$last_profile" ]]; then
    # Nothing changed — skip the powerprofilesctl call entirely to avoid
    # asusd re-evaluating EPP and rewriting fan curves on every event.
    exit 0
fi

# ---------------------------------------------------------------------------
# 3. Run the original script, persist state, and record cooldown
# ---------------------------------------------------------------------------
if "$ORIG_SCRIPT" "$action"; then
    echo "$action $target_profile" > "$STATEFILE"
    date +%s > "$COOLDOWN_FILE"
fi
