#!/bin/bash
# Debounced user wrapper around Omarchy's omarchy-powerprofiles-set.
#
# Why this exists
# ---------------
# The ROG Flow Z13's embedded controller reports spurious line-power state. On
# this machine AC0.online (and therefore UPower.onBattery) flaps:
#   * a few times per few minutes while charging near the top of the range, and
#   * at roughly 1 Hz under heavy load while charging on an under-rated supply
#     (a 140 W SlimQ, where the Z13 ships with a 200 W adapter).
#
# Omarchy 4's omarchy.battery service calls omarchy-powerprofiles-set on every
# UPower.onBatteryChanged. Each flap therefore flipped the platform profile
# Performance <-> Balanced, and asusd rewrote the fan curve on every flip.
#
# This wrapper keys on BAT0.status (actual power flow) instead of UPower's
# line-power view, and only acts once that reading has settled. A flap that
# returns to where it started never changes the profile; a real plug/unplug is
# applied after the settle window. During a sustained flap storm nothing
# settles, so the wrapper leaves the profile alone rather than churning it.
#
# It lives in ~/.local/bin and is put ahead of /usr/share/omarchy/bin on the
# compositor's PATH by ~/.config/hypr/z13.lua, so the shell, session autostart
# and DeckShift all resolve it. No udev rule, no root, no RUN+=.
#
# upstream is /usr/bin/omarchy-powerprofiles-set (the packaged script). This
# wrapper never edits that file, so Omarchy updates are safe.

set -u

ORIG_SCRIPT="${Z13_ORIG_SCRIPT:-/usr/bin/omarchy-powerprofiles-set}"

# Sysfs roots, overridable so the settle logic can be exercised against fixture
# trees (scripts/test-z13-power-profiles-wrapper.sh).
POWER_SUPPLY_ROOT="${Z13_POWER_SUPPLY_ROOT:-/sys/class/power_supply}"
PLATFORM_PROFILE_PATH="${Z13_PLATFORM_PROFILE:-/sys/firmware/acpi/platform_profile}"

# Wait-for-stability: require STABLE_READS consecutive agreeing readings,
# polling every INTERVAL seconds, giving up after MAX_SAMPLES reads. A mismatch
# restarts the window rather than aborting, so a mid-transition start converges
# on the settled value; an unrecognised reading (e.g. "Unknown" during a
# transition) also restarts it.
#
# Four reads (~3 s), not two: the EC's charge-boundary flaps last 1-2 s, which
# two 1 s samples cannot tell apart from a real unplug. Those flaps settled as
# "battery", applied power-saver (platform_profile quiet) and were only undone
# by the ac call a second later. A genuine unplug now applies after ~3 s, which
# nothing depends on; explicit profile picks bypass settling entirely.
STABLE_READS=4
INTERVAL="${Z13_SETTLE_INTERVAL:-1}"
MAX_SAMPLES=10

# Battery switches only: an asymmetric burst guard. The EC can hold
# BAT0.status=Discharging for ~5 s across a burst of AC edges. Four reads still
# settles that, and the matching ac call then undoes it (2026-11-05 21:44-21:57:
# four visible down/up blips). When another automatic call happened within
# BURST_WINDOW, a battery switch must instead see BURST_STABLE_READS agreeing
# readings (~9 s). ac restores keep the normal window, so a real replug is not
# delayed. Explicit profile picks bypass both windows.
BURST_WINDOW=180
BURST_STABLE_READS=10
BURST_MAX_SAMPLES=14

# Atomic deduplication: only one instance may proceed. mkdir is atomic, so an
# event burst collapses to a single evaluation instead of a thundering herd.
# A crashed run can leave the sentinel behind; reclaim it once it is stale.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PROCESSING="${RUNTIME_DIR}/z13-powerprofiles.processing"
EVENTS_FILE="${RUNTIME_DIR}/z13-powerprofiles.events"
mkdir -p "$RUNTIME_DIR" 2>/dev/null || true

log() {
    if [[ -n ${Z13_POWER_LOG:-} ]]; then
        printf '%s\n' "$*" >> "$Z13_POWER_LOG" 2>/dev/null || true
        return 0
    fi
    logger -t z13-powerprofiles "$*" 2>/dev/null || true
}

# Identify the holder so a leaked sentinel is attributable instead of anonymous.
sentinel_owner() {
    local desc="unknown"
    if [[ -r $PROCESSING/owner ]]; then
        desc=$(tr '\n' ' ' < "$PROCESSING/owner" 2>/dev/null)
        desc=${desc% }
    fi
    printf '%s' "${desc:-unknown}"
}

if ! mkdir "$PROCESSING" 2>/dev/null; then
    if [[ -d $PROCESSING ]]; then
        age=$(( $(date +%s) - $(stat -c %Y "$PROCESSING" 2>/dev/null || echo 0) ))
        if (( age > 30 )); then
            log "reclaiming stale sentinel age=${age}s owner=$(sentinel_owner)"
            rm -rf -- "$PROCESSING"
            mkdir "$PROCESSING" 2>/dev/null || { log "skipped: could not reclaim sentinel"; exit 0; }
        else
            # Never silent: a dropped call looks exactly like "nothing happened",
            # which is how the 2026-11-05 sentinel leak went unnoticed.
            log "skipped: sentinel held age=${age}s owner=$(sentinel_owner)"
            exit 0
        fi
    else
        log "skipped: sentinel path exists and is not a directory"
        exit 0
    fi
fi
# Remove the whole directory: the owner file lives inside it, so a plain rmdir
# would fail and leave the sentinel wedged.
cleanup() { rm -rf -- "$PROCESSING" 2>/dev/null || true; }
trap cleanup EXIT

{
    printf 'pid=%s\n' "$$"
    printf 'parent_pid=%s\n' "$PPID"
    printf 'parent=%s\n' "$(ps -o comm= -p "$PPID" 2>/dev/null || echo unknown)"
    printf 'since=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
} > "$PROCESSING/owner" 2>/dev/null || true

# Run the original script to completion instead of exec'ing into it. `exec`
# replaces this shell, so the EXIT trap never runs and $PROCESSING is left
# behind; every call in the next 30 s then hits the "not stale yet" branch and
# exits silently. That is how a one-second EC flap on 2026-11-05 left the
# machine on power-saver (platform_profile quiet) after the ac restore was
# dropped. A plain invocation keeps the sentinel until this script exits.
run_orig() {
    "$ORIG_SCRIPT" "$@"
}

# Record this automatic call and return how many calls have happened in the
# last BURST_WINDOW seconds, including this one. The sentinel guarantees a
# single writer, so a plain read-modify-write is safe. An unwritable runtime
# dir degrades to "one event", i.e. the normal window, rather than guessing a
# burst.
record_event() {
    local now cutoff tmp count
    now=$(date +%s)
    cutoff=$(( now - BURST_WINDOW ))
    tmp="${EVENTS_FILE}.tmp.$$"
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
    if {
            if [[ -r $EVENTS_FILE ]]; then
                awk -v c="$cutoff" '$1 ~ /^[0-9]+$/ && ($1 + 0) > c' "$EVENTS_FILE" 2>/dev/null
            fi
            printf '%s\n' "$now"
        } > "$tmp" 2>/dev/null; then
        count=$(awk 'END { print NR + 0 }' "$tmp" 2>/dev/null) || count=1
        mv -f -- "$tmp" "$EVENTS_FILE" 2>/dev/null || rm -f -- "$tmp" 2>/dev/null
    else
        rm -f -- "$tmp" 2>/dev/null
        count=1
    fi
    printf '%s\n' "${count:-1}"
}

# ---------------------------------------------------------------------------
# Resolve the real power source from BAT0.status.
# ---------------------------------------------------------------------------

# Locate the system battery: type=Battery, excluding peripherals (scope=Device,
# e.g. the Elan touchpad's hid-...-battery-7, which reports capacity 0).
find_system_battery() {
    local ps scope
    for ps in "$POWER_SUPPLY_ROOT"/*; do
        [[ -r $ps/type && -r $ps/status ]] || continue
        [[ $(cat "$ps/type") == Battery ]] || continue
        scope=$(cat "$ps/scope" 2>/dev/null || echo "")
        [[ $scope == Device ]] && continue
        printf '%s\n' "$ps"
        return 0
    done
    return 1
}

# Map BAT0.status to an action. Returns non-zero on an inconclusive reading so
# the caller retries.
read_battery_action() {
    local status
    status=$(cat "$1/status" 2>/dev/null) || return 1
    case "$status" in
        Discharging)                  echo battery ;;
        Charging|"Not charging"|Full) echo ac ;;
        *)                            return 1 ;;
    esac
}

# Fallback for machines without a readable system battery: treat any Mains or
# USB supply reporting online=1 as AC.
read_ac_action() {
    local found=0 ps type
    for ps in "$POWER_SUPPLY_ROOT"/*; do
        [[ -r $ps/online && -r $ps/type ]] || continue
        type=$(cat "$ps/type")
        [[ $type == Mains || $type == USB ]] || continue
        if [[ $(cat "$ps/online") == 1 ]]; then
            found=1
            break
        fi
    done
    [[ $found == 1 ]] && echo ac || echo battery
}

detect_action() {
    local bat
    if bat=$(find_system_battery); then
        read_battery_action "$bat"
    else
        read_ac_action
    fi
}

settle_action() {
    local required="${1:-$STABLE_READS}" max="${2:-$MAX_SAMPLES}"
    local current prev="" agree=0 i action="" samples=""
    for (( i = 0; i < max; i++ )); do
        if current=$(detect_action); then
            samples+="$current "
            if [[ -n $prev && $current == "$prev" ]]; then
                agree=$((agree + 1))
                if (( agree >= required - 1 )); then
                    action="$current"
                    break
                fi
            else
                agree=0
            fi
            prev="$current"
        else
            samples+="? "
            prev=""
            agree=0
        fi
        sleep "$INTERVAL"
    done
    if [[ -z $action ]]; then
        log "power source did not settle after $max samples (readings: ${samples% })"
    fi
    printf '%s\n' "$action"
}

# ---------------------------------------------------------------------------
# Profile reads.
# ---------------------------------------------------------------------------

# PPD maps its profiles one-to-one onto platform_profile: power-saver -> quiet,
# balanced -> balanced, performance -> performance. asusd reacts to
# platform_profile, so this is the profile that actually matters.
read_platform_profile() {
    local p
    p=$(cat "$PLATFORM_PROFILE_PATH" 2>/dev/null) || return 1
    [[ -n $p ]] || return 1
    case "$p" in
        quiet) printf 'power-saver\n' ;;
        *)     printf '%s\n' "$p" ;;
    esac
}

# Ask PPD over D-Bus rather than through powerprofilesctl: that is a PyGObject
# script, and Omarchy avoids spawning it because a CPython 3.14 shutdown race
# (python/cpython#124619) can kill it with SIGSEGV.
profile_available() {
    if [[ -n ${Z13_PROFILES_AVAILABLE:-} ]]; then
        [[ " ${Z13_PROFILES_AVAILABLE} " == *" $1 "* ]]
        return
    fi
    busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles \
        net.hadess.PowerProfiles Profiles 2>/dev/null | grep -q "\"$1\""
}

# ---------------------------------------------------------------------------
# Argument handling.
# ---------------------------------------------------------------------------
# Callers:
#   omarchy.battery service : omarchy-powerprofiles-set ac|battery
#   power panel             : omarchy-powerprofiles-set ac|battery <profile>
#   menu / DeckShift        : omarchy-powerprofiles-set autodetect <profile>
#   omarchy-powerprofiles-init : omarchy-powerprofiles-set autodetect

if (( $# > 2 )); then
    # Let the real script print its usage error.
    run_orig "$@"
    rc=$?
    log "usage error: rc=$rc argc=$#"
    exit "$rc"
fi

action_arg="${1:-autodetect}"
profile_arg="${2:-}"

# Explicit picks are user-driven and must not wait for the settle window: the
# power panel and DeckShift expect the profile to change immediately, and the
# packaged script resolves `autodetect` itself.
if [[ -n $profile_arg ]]; then
    log "applying explicit profile '$profile_arg' for $action_arg"
    run_orig "$action_arg" "$profile_arg"
    rc=$?
    log "applied: action=$action_arg profile=$profile_arg rc=$rc"
    exit "$rc"
fi

# Burst guard: the shell only passes ac|battery (autodetect is the session
# init), so the direction is known before the wait. Only a battery switch is
# delayed; ac restores keep the fast window.
events=$(record_event)
reads=$STABLE_READS
max=$MAX_SAMPLES
if [[ $action_arg == battery ]] && (( events >= 2 )); then
    reads=$BURST_STABLE_READS
    max=$BURST_MAX_SAMPLES
    log "burst guard: ${events} events in ${BURST_WINDOW}s; requiring ${reads} reads"
fi

action=$(settle_action "$reads" "$max")
if [[ -z $action ]]; then
    log "leaving profile unchanged"
    exit 0
fi

# Idempotency: skip when the profile for this action is already active. This
# prevents a redundant set (and asusd fan-curve rewrite) when the settled source
# maps to the profile already in use.
state_dir="${OMARCHY_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/powerprofiles}"
state_file="$state_dir/$action"
target=""
[[ -r $state_file ]] && target=$(<"$state_file")
if [[ -z $target ]]; then
    if [[ $action == ac ]] && profile_available performance; then
        target=performance
    else
        target=balanced
    fi
fi

current=$(read_platform_profile 2>/dev/null || true)
if [[ -n $current && $current == "$target" ]]; then
    log "settled on $action; profile already $target"
    exit 0
fi

log "settled on $action; applying $target"
run_orig "$action"
rc=$?
log "applied: action=$action profile=$target rc=$rc"
exit "$rc"
