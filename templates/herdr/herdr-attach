#!/bin/bash
# Launch or attach Herdr, then refresh OpenCode's system theme once the client
# has supplied the host terminal palette. The prefix+shift+t binding in
# ~/.config/herdr/config.toml is the manual fallback.
set -u

refresh="$HOME/.local/bin/opencode-refresh-theme"

(
    # The client connects in well under a second; give the server a moment to
    # apply the host palette before asking OpenCode to re-read it.
    sleep 2
    if [[ -x $refresh ]]; then
        "$refresh" || true
    fi
) &

exec herdr "$@"
